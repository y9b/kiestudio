# Copie este arquivo para .env e preencha sua chave.
# Copy this file to .env and fill in your key.

# API key da KIE — crie em https://kie.ai/api-key
# (opcional: você também pode informar a chave pela tela de Configurações do app)
KIE_API_KEY=

# Porta do servidor (API + app em produção)
PORT=8787

# Endereço em que o servidor escuta. Use 0.0.0.0 para acessar de outros dispositivos da rede (ou no Docker).
HOST=127.0.0.1

# Pasta onde ficam o banco SQLite e as mídias geradas (relativa à raiz do projeto)
DATA_DIR=data

# Baixar automaticamente os resultados para DATA_DIR/media (a KIE apaga os arquivos após 14 dias)
DOWNLOAD_MEDIA=true
